---
import Layout from "../layouts/Layout.astro";
import AudioPlayer from "../components/AudioPlayer.astro";
import EpisodeMeta from "../components/EpisodeMeta.astro";
import ListenLinks from "../components/ListenLinks.astro";
import { getShow } from "../lib/podcast";

const show = await getShow();
const [latest, ...older] = show.episodes;
---

<Layout title={show.title}>
  <section class="grid items-center gap-10 pb-14 pt-8 sm:pt-14 md:grid-cols-[1fr_auto] md:gap-16">
    <div>
      <h1 class="text-5xl font-black tracking-tight sm:text-6xl">{show.title}</h1>
      <p class="mt-6 max-w-[34em] text-lg leading-relaxed text-ink-muted">
        兩個在東京、福岡工作的 30 代軟體工程師
        <span class="font-semibold text-ink">Kalan</span> 與
        <span class="font-semibold text-ink">Mooly</span>，聊日本生活、職涯、科技與人生的大小事。
      </p>
      <ListenLinks class="mt-8" />
    </div>
    <img src="/favicon.svg" alt="" width="240" height="240" class="mr-4 hidden w-60 md:block" />
  </section>

  <section aria-labelledby="latest" class="rounded-3xl border border-line bg-surface p-6 sm:p-8">
    <p class="text-sm font-semibold text-primary">最新一集</p>
    <h2 id="latest" class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">
      <a href={`/episodes/${latest.number}`} class="hover:text-primary">
        <span class="text-ink-muted">EP{latest.number}</span> {latest.title}
      </a>
    </h2>
    <EpisodeMeta episode={latest} class="mt-2" />
    <p class="mt-4 line-clamp-3 max-w-[42em] leading-relaxed">{latest.summary}</p>
    <div class="mt-6 max-w-xl">
      <AudioPlayer episode={latest} />
    </div>
  </section>

  <section aria-labelledby="all" class="mt-16">
    <h2 id="all" class="text-sm font-semibold text-ink-muted">所有集數</h2>
    <ol class="mt-4 divide-y divide-line border-y border-line">
      {
        older.map((episode) => (
          <li>
            <a
              href={`/episodes/${episode.number}`}
              class="group -mx-3 grid grid-cols-[3rem_1fr] gap-x-4 rounded-xl px-3 py-6 transition-colors duration-150 ease-out hover:bg-surface sm:grid-cols-[4rem_1fr]"
            >
              <span class="text-3xl font-black tabular-nums tracking-tight text-[oklch(0.62_0.02_196)] transition-colors duration-150 ease-out group-hover:text-coral sm:text-4xl">
                <span class="sr-only">EP</span>
                {String(episode.number).padStart(2, "0")}
              </span>
              <span class="min-w-0">
                <span class="block text-lg font-bold leading-snug tracking-tight transition-colors duration-150 ease-out group-hover:text-primary">
                  {episode.title}
                </span>
                <EpisodeMeta episode={episode} class="mt-1" />
                <span class="mt-2 line-clamp-2 max-w-[42em] text-[0.9375rem] leading-relaxed text-ink-muted">
                  {episode.summary}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
