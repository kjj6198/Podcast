---
import Layout from "../layouts/Layout.astro";
import Parser from "rss-parser";

const parser = new Parser();
const feed = await parser.parseURL(import.meta.env.RSS_FEED_URL);

const episodes = feed.items.map((item) => ({
  title: item.title,
  date: new Date(item.pubDate!!).toLocaleDateString(),
  description: item.contentSnippet,
  link: item.link,
  mp3: item.enclosure?.url,
  summary: item.itunes.summary,
  episode: item.itunes.episode,
  duration: item.itunes.duration,
  image: item.itunes.image,
}));
---

<Layout title="八百屋 Boys">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-gray-900 mb-8 text-center">
      {feed.title}
    </h1>

    <p class="mb-8">
      這是由兩個在日本的東京、福岡工作的30 代軟體工程師Kalan 與Mooly
      所設立的Podcast，與你分享各種日本生活、職涯、科技、人生的大小事。
    </p>

    <div class="space-y-6">
      {
        episodes.map((episode) => (
          <article class="bg-white shadow rounded-lg p-6 hover:shadow-lg transition-shadow">
            <img
              src={episode.image}
              alt={episode.title}
              class="w-24 rounded-lg mb-4"
            />
            <h2 class="text-2xl font-semibold text-gray-800 mb-2">
              {episode.title}
            </h2>
            <audio controls>
              <source src={episode.mp3} type="audio/mpeg" class="w-full" />
            </audio>
            <div class="mt-4 flex items-center">
              <span class="text-sm text-gray-500 mr-2">
                第 {episode.episode || "0"} 集
              </span>
            </div>
            <p class="text-gray-600 line-clamp-3">{episode.description}</p>
            <a
              href={`/episodes/${episode.episode || "0"}`}
              class="mt-4 inline-block text-indigo-600 hover:text-indigo-800 font-medium"
            >
              Listen to episode →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
