---
import { getShow } from "../lib/podcast";

interface Props {
  title: string;
  description?: string;
}

const show = await getShow();
const {
  title,
  description = "兩個在東京、福岡工作的 30 代軟體工程師 Kalan 與 Mooly，聊日本生活、職涯、科技與人生的大小事。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={show.title} href={show.feedUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..800&family=Noto+Sans+TC:wght@400..900&display=swap"
    />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={show.image} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased selection:bg-coral selection:text-paper">
    <header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
      <a href="/" class="group -m-1 flex items-center gap-2.5 rounded-lg p-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring">
        <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
        <span class="text-lg font-bold tracking-tight">{show.title}</span>
      </a>
      <nav class="flex items-center gap-1 text-sm font-medium" aria-label="收聽平台">
        <a href={show.link} class="nav-link">SoundOn</a>
        <a href={show.feedUrl} class="nav-link">RSS</a>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-5 pb-24 sm:px-8">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-ink-muted sm:px-8">
        <span>{show.title}</span>
        <a href="mailto:contact@yaoyaboys.com" class="underline decoration-line underline-offset-4 hover:text-ink hover:decoration-ink-muted">
          contact@yaoyaboys.com
        </a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    font-optical-sizing: auto;
    -webkit-text-size-adjust: 100%;
  }

  :where(h1, h2, h3) {
    font-feature-settings: "palt";
    text-wrap: balance;
  }

  :where(a, button, input):focus-visible {
    outline: 2px solid theme("colors.ring");
    outline-offset: 2px;
  }

  .nav-link {
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    color: theme("colors.ink.muted");
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }

  .nav-link:hover {
    color: theme("colors.ink.DEFAULT");
    background-color: theme("colors.muted");
  }
</style>
