---
import { Icon } from "astro-icon/components";
import { formatDate, formatDuration, type Episode } from "../lib/podcast";

interface Props {
  episode: Episode;
  class?: string;
}

const { episode, class: className } = Astro.props;
---

<span class:list={["flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-muted", className]}>
  <span class="inline-flex items-center gap-1.5">
    <Icon name="ri:calendar-line" class="size-4" aria-hidden="true" />
    <time datetime={episode.publishedAt.toISOString()}>{formatDate(episode.publishedAt)}</time>
  </span>
  <span class="inline-flex items-center gap-1.5">
    <Icon name="ri:time-line" class="size-4" aria-hidden="true" />
    {formatDuration(episode.durationSeconds)}
  </span>
</span>
