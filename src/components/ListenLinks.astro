---
import { Icon } from "astro-icon/components";
import { getShow } from "../lib/podcast";

interface Props {
  class?: string;
}

const show = await getShow();

const platforms = [
  { name: "Apple Podcasts", icon: "ri:apple-fill", href: "https://podcasts.apple.com/tw/podcast/id1785488068" },
  { name: "Spotify", icon: "ri:spotify-fill", href: "https://open.spotify.com/show/04dIK1zluuhOpm7sxYcSAM" },
  { name: "SoundOn", icon: "ri:headphone-fill", href: show.link },
  { name: "RSS", icon: "ri:rss-fill", href: show.feedUrl },
];
---

<ul class:list={["flex flex-wrap gap-2", Astro.props.class]}>
  {
    platforms.map((platform) => (
      <li>
        <a
          href={platform.href}
          class="inline-flex h-10 items-center gap-2 rounded-full border border-line bg-paper pl-3.5 pr-4 text-sm font-semibold transition-colors duration-150 ease-out hover:border-ink hover:bg-ink hover:text-paper"
        >
          <Icon name={platform.icon} class="size-[1.125rem]" aria-hidden="true" />
          {platform.name}
        </a>
      </li>
    ))
  }
</ul>
