---
import type { Episode } from "../lib/podcast";
import { Icon } from "astro-icon/components";
import { formatTime } from "../lib/time";

interface Props {
  episode: Episode;
  captions?: boolean;
}

const { episode, captions = false } = Astro.props;
const total = formatTime(episode.durationSeconds);
---

<audio-player class="block">
  <div class="flex items-center gap-4">
    <button
      type="button"
      data-toggle
      aria-label={`播放 EP${episode.number}`}
      class="grid size-12 shrink-0 place-items-center rounded-full bg-primary text-primary-foreground transition-colors duration-150 ease-out hover:bg-ink aria-busy:animate-pulse motion-reduce:animate-none"
    >
      <Icon name="ri:play-fill" data-icon="play" class="ml-0.5 size-6" aria-hidden="true" />
      <Icon name="ri:pause-fill" data-icon="pause" class="hidden size-6" aria-hidden="true" />
    </button>
    <div class="min-w-0 flex-1">
      <input
        type="range"
        data-seek
        min="0"
        max={episode.durationSeconds}
        step="1"
        value="0"
        aria-label="播放進度"
        aria-valuetext={`0:00 / ${total}`}
        class="w-full cursor-pointer accent-[theme(colors.primary.DEFAULT)]"
      />
      <div class="mt-1 flex justify-between text-xs tabular-nums text-ink-muted">
        <span data-current>0:00</span>
        <span>{total}</span>
      </div>
    </div>
  </div>
  {
    captions && (
      <p data-caption hidden class="mt-4 line-clamp-2 border-t border-line pt-3 leading-relaxed">
        <span data-caption-speaker class="font-bold" />
        <span data-caption-text class="ml-2" />
      </p>
    )
  }
  <p data-error role="alert" hidden class="mt-3 text-sm text-ink-muted">
    <Icon name="ri:error-warning-line" class="mr-1 inline size-4 align-[-0.2em]" aria-hidden="true" />無法播放這集，請改到 <a href={episode.link} class="font-medium text-primary underline underline-offset-4">SoundOn</a> 收聽。
  </p>
  <audio preload="none" src={episode.mp3}></audio>
</audio-player>

<script>
  import { formatTime } from "../lib/time";

  class AudioPlayer extends HTMLElement {
    connectedCallback() {
      const audio = this.querySelector("audio")!;
      const toggle = this.querySelector<HTMLButtonElement>("[data-toggle]")!;
      const seek = this.querySelector<HTMLInputElement>("[data-seek]")!;
      const current = this.querySelector<HTMLElement>("[data-current]")!;
      const error = this.querySelector<HTMLElement>("[data-error]")!;
      const label = toggle.getAttribute("aria-label")!;
      const total = formatTime(Number(seek.max));

      const showTime = (seconds: number) => {
        current.textContent = formatTime(seconds);
        seek.setAttribute("aria-valuetext", `${formatTime(seconds)} / ${total}`);
      };

      const render = () => {
        toggle.querySelector('[data-icon="play"]')!.classList.toggle("hidden", !audio.paused);
        toggle.querySelector('[data-icon="pause"]')!.classList.toggle("hidden", audio.paused);
        toggle.setAttribute("aria-label", audio.paused ? label : label.replace("播放", "暫停"));
      };

      toggle.addEventListener("click", () => {
        if (audio.paused) {
          document.querySelectorAll("audio").forEach((other) => other !== audio && other.pause());
          audio.play().catch(() => {});
        } else {
          audio.pause();
        }
      });
      seek.addEventListener("input", () => {
        audio.currentTime = Number(seek.value);
        showTime(audio.currentTime);
      });
      audio.addEventListener("timeupdate", () => {
        seek.value = String(audio.currentTime);
        showTime(audio.currentTime);
      });
      audio.addEventListener("waiting", () => toggle.setAttribute("aria-busy", "true"));
      audio.addEventListener("playing", () => toggle.removeAttribute("aria-busy"));
      audio.addEventListener("play", render);
      audio.addEventListener("pause", () => {
        toggle.removeAttribute("aria-busy");
        render();
      });
      audio.addEventListener("error", () => {
        toggle.removeAttribute("aria-busy");
        error.hidden = false;
      });
    }
  }

  customElements.define("audio-player", AudioPlayer);
</script>
